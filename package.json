{
  "name": "veritas-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Veritas Engine - academic integrity and plagiarism analysis platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker.ts",
    "smoke": "tsx scripts/smoke.mts",
    "local": "powershell -ExecutionPolicy Bypass -File scripts/local-dev.ps1",
    "local:clean": "powershell -ExecutionPolicy Bypass -File scripts/local-dev.ps1 -Clean"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bullmq": "^6.4.2",
    "clsx": "^2.1.1",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.10.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unpdf": "^1.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "eslint": "^10.13.0",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.11"
  }
}
