{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "ANALYSIS_MODE": "inline",
    "SEMANTIC_SIMILARITY_THRESHOLD": "0.6"
  }
}